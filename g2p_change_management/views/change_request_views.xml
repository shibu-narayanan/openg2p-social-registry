<menuitem id="menu_change_management_root"
          name="Change Request"
          sequence="10"/>

<menuitem id="menu_change_request"
          name="Change Requests"
          parent="menu_change_management_root"
          action="action_change_request"
          sequence="10"/>

</odoo>
