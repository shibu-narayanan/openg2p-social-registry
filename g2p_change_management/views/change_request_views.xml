<odoo>

<record id="view_change_request_tree" model="ir.ui.view">
    <field name="name">change.request.tree</field>
    <field name="model">change.request</field>
    <field name="arch" type="xml">
        <tree multi_edit="1" create="true" delete="true" 
              decoration-info="state == 'draft'" 
              decoration-warning="state == 'submitted'" 
              decoration-success="state == 'approved'" 
              decoration-danger="state == 'rejected'">
            <field name="name"/>
            <field name="type"/>
            <field name="is_group" string="Group"/>
            <field name="partner_name"/>
            <field name="requester_id"/>
            <field name="state"/>
            <field name="create_date"/>
        </tree>
    </field>
</record>

<record id="view_change_request_form" model="ir.ui.view">
    <field name="name">change.request.form</field>
    <field name="model">change.request</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="action_submit" string="Submit" type="object" 
                        class="btn-primary" 
                        invisible="state != 'draft'"/>
                <button name="action_approve" string="Approve" type="object" 
                        class="btn-success" 
                        invisible="state != 'submitted'"/>
                <button name="action_reject" string="Reject" type="object" 
                        class="btn-danger" 
                        invisible="state != 'submitted'"/>
                <button name="action_edit_draft_record" string="Go to Draft" type="object" 
                        class="btn-info" 
                        invisible="not draft_record_id"/>
                <field name="state" widget="statusbar" 
                       statusbar_visible="draft,submitted,approved,rejected"/>
            </header>
            <sheet>
                                            <group>
                    <field name="name"/>
                    <field name="type" readonly="1"/>
                    <field name="is_group" readonly="draft_record_id"/>
                    <field name="group_kind_id" invisible="type != 'create' or not is_group" readonly="draft_record_id"/>
                    <field name="state"/>
                    <field name="requester_id"/>
                    <field name="partner_id"/>
                    <field name="description" placeholder="Describe the changes being requested..."/>
                </group>
                
                <!-- Draft Record Information - Direct in main form -->
                <field name="draft_record_id" invisible="1"/>
                <group string="Draft Record Information" invisible="not draft_record_id">
                    <field name="draft_given_name" readonly="1" invisible="is_group"/>
                    <field name="draft_family_name" readonly="1" invisible="is_group"/>
                    <field name="draft_phone" readonly="1"/>
                    <field name="draft_region" readonly="1"/>
                </group>
                

                
                <!-- No Draft Record Message -->
                <div invisible="draft_record_id" class="alert alert-info" role="alert">
                    <strong>No Draft Record Available</strong><br/>
                    A draft record will be created automatically when you save this change request.
                </div>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
        </form>
    </field>
</record>

<record id="view_change_request_search" model="ir.ui.view">
    <field name="name">change.request.search</field>
    <field name="model">change.request</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <field name="partner_name"/>
            <field name="requester_id"/>
            <field name="type"/>
            <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
            <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
            <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
            <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
            <filter string="My Requests" name="my_requests" domain="[('requester_id', '=', uid)]"/>
            <group expand="0" string="Group By">
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Type" name="group_type" context="{'group_by': 'type'}"/>
                <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:day'}"/>
            </group>
        </search>
    </field>
</record>

<record id="action_change_request" model="ir.actions.act_window">
    <field name="name">Change Requests</field>
    <field name="res_model">change.request</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_my_requests': 1}</field>
    <field name="view_id" ref="view_change_request_tree"/>
    <field name="binding_model_id" ref="model_change_request"/>
    <field name="binding_view_types">list</field>
</record>

<!-- Bulk Operations Actions -->
<record id="action_bulk_approve" model="ir.actions.server">
    <field name="name">Bulk Approve</field>
    <field name="model_id" ref="model_change_request"/>
    <field name="state">code</field>
    <field name="binding_model_id" ref="model_change_request"/>
    <field name="binding_view_types">list</field>
    <field name="groups_id" eval="[(4, ref('g2p_change_management.group_change_approver'))]"/>
    <field name="code">
if records:
    action = records.action_bulk_approve()
</field>
</record>

